{
  "name": "@webui/docs",
  "version": "0.1.0",
  "description": "WebUI Framework Documentation",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare:benchmarks": "node .webui-press/scripts/prepare-benchmarks.mjs",
    "prepare:redirects": "node .webui-press/scripts/prepare-redirects.mjs",
    "build": "pnpm run prepare:benchmarks && pnpm run prepare:redirects && webui press build",
    "start": "pnpm run prepare:benchmarks && pnpm run prepare:redirects && webui press serve"
  },
  "dependencies": {
    "@codemirror/commands": "catalog:",
    "@codemirror/lang-css": "catalog:",
    "@codemirror/lang-html": "catalog:",
    "@codemirror/lang-json": "catalog:",
    "@codemirror/language": "catalog:",
    "@codemirror/state": "catalog:",
    "@codemirror/theme-one-dark": "catalog:",
    "@codemirror/view": "catalog:",
    "@microsoft/webui": "workspace:*",
    "@microsoft/webui-framework": "workspace:*",
    "@microsoft/webui-press": "workspace:*",
    "esbuild": "catalog:"
  }
}

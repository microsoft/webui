{
  "description": "Lightweight client-side router for WebUI apps. Intercepts navigation, matches routes locally or via server route-data, and hydrates components.",
  "devDependencies": {
    "@microsoft/webui-framework": "workspace:*",
    "@microsoft/webui-router": "workspace:*",
    "@playwright/test": "catalog:",
    "@types/dom-navigation": "catalog:",
    "@types/dom-view-transitions": "catalog:",
    "@types/node": "catalog:",
    "esbuild": "catalog:",
    "typescript": "catalog:",
    "urlpattern-polyfill": "catalog:"
  },
  "exports": {
    "./lazy.js": {
      "import": {
        "types": "./dist/lazy-entry.d.ts",
        "default": "./dist/lazy-entry.js"
      }
    },
    "./lazy-ndjson.js": {
      "import": {
        "types": "./dist/lazy-ndjson.d.ts",
        "default": "./dist/lazy-ndjson.js"
      }
    },
    "./core.js": {
      "import": {
        "types": "./dist/core.d.ts",
        "default": "./dist/core.js"
      }
    },
    "./resources.js": {
      "import": {
        "types": "./dist/resources-entry.d.ts",
        "default": "./dist/resources-entry.js"
      }
    },
    "./ndjson.js": {
      "import": {
        "types": "./dist/streaming.d.ts",
        "default": "./dist/streaming.js"
      }
    },
    "./cache.js": {
      "import": {
        "types": "./dist/cache.d.ts",
        "default": "./dist/cache.js"
      }
    },
    "./actions.js": {
      "import": {
        "types": "./dist/actions.d.ts",
        "default": "./dist/actions.js"
      }
    },
    "./route-preload.js": {
      "import": {
        "types": "./dist/preload.d.ts",
        "default": "./dist/preload.js"
      }
    },
    "./boundaries.js": {
      "import": {
        "types": "./dist/boundaries.d.ts",
        "default": "./dist/boundaries.js"
      }
    },
    "./transitions.js": {
      "import": {
        "types": "./dist/view-transitions.d.ts",
        "default": "./dist/view-transitions.js"
      }
    },
    "./diagnostics.js": {
      "import": {
        "types": "./dist/diagnostics.d.ts",
        "default": "./dist/diagnostics.js"
      }
    },
    "./ndjson-reader.js": {
      "import": {
        "types": "./dist/ndjson-reader.d.ts",
        "default": "./dist/ndjson-reader.js"
      }
    },
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./preload.js": {
      "import": {
        "types": "./dist/preload-entry.d.ts",
        "default": "./dist/preload-entry.js"
      }
    }
  },
  "files": [
    "dist/"
  ],
  "license": "MIT",
  "name": "@microsoft/webui-router",
  "scripts": {
    "build": "tsc",
    "build:e2e": "esbuild tests/fixtures/router-app/src/index.ts tests/fixtures/router-app/src/interaction-entry.ts --bundle --outdir=tests/fixtures/router-app/dist --format=esm --splitting --sourcemap --tsconfig=tsconfig.e2e.json && esbuild tests/fixtures/router-app/src/lean-entry.ts --bundle --outfile=tests/fixtures/router-app/dist/lean-entry.js --format=esm --sourcemap --tsconfig=tsconfig.e2e.json",
    "start:server": "cargo run -p microsoft-webui-cli -- serve ./tests/fixtures/router-app/src --plugin=webui --servedir ./tests/fixtures/router-app/dist --state ./tests/fixtures/router-app/data/state.json --port 39102",
    "test": "tsc -p tsconfig.unit-test.json && node --test dist/**/*.test.js && pnpm build:e2e && playwright test",
    "test:e2e": "playwright test",
    "test:update-snapshots": "playwright test --update-snapshots",
    "typecheck": "tsc --noEmit"
  },
  "type": "module",
  "publishConfig": {
    "tag": "latest"
  },
  "version": "3.0.4"
}

{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "declaration": false,
    "experimentalDecorators": true,
    "incremental": false,
    "lib": ["ESNext", "DOM"],
    "noEmit": true,
    "rootDir": "..",
    "skipLibCheck": false,
    "types": ["dom-navigation", "dom-view-transitions"],
    "useDefineForClassFields": false
  },
  "include": ["tests/type-compat.ts"],
  "exclude": ["node_modules", "dist"]
}

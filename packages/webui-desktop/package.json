{
  "name": "@microsoft/webui-desktop",
  "version": "0.0.29",
  "description": "Opt-in native desktop CLI and typed browser IPC runtime for WebUI",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist/"
  ],
  "scripts": {
    "build": "tsc && node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "pnpm build && tsc -p tsconfig.test.json && node --test dist-test/**/*.test.js"
  },
  "dependencies": {},
  "optionalDependencies": {
    "@microsoft/webui-desktop-darwin-arm64": "workspace:*",
    "@microsoft/webui-desktop-darwin-x64": "workspace:*",
    "@microsoft/webui-desktop-linux-arm64": "workspace:*",
    "@microsoft/webui-desktop-linux-x64": "workspace:*",
    "@microsoft/webui-desktop-win32-arm64": "workspace:*",
    "@microsoft/webui-desktop-win32-x64": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "esbuild": "catalog:",
    "typescript": "catalog:"
  },
  "publishConfig": {
    "tag": "latest"
  }
}

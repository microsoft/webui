{
  "name": "@microsoft/webui-framework",
  "version": "3.0.5",
  "publishConfig": {
    "tag": "latest"
  },
  "type": "module",
  "sideEffects": [
    "./tests/**",
    "./dist/styles-entry.js",
    "./dist/lazy-entry.js",
    "./dist/template-cache-entry.js",
    "./dist/streaming-entry.js",
    "./dist/streaming-coordinator.js",
    "./dist/streaming-deferred.js",
    "./dist/lazy-hydration-entry.js",
    "./src/styles-entry.ts",
    "./src/lazy-entry.ts",
    "./src/template-cache-entry.ts",
    "./src/streaming-entry.ts",
    "./src/streaming-coordinator.ts",
    "./src/streaming-deferred.ts",
    "./src/lazy-hydration-entry.ts"
  ],
  "description": "WebUI Framework Next — lightweight Web Component runtime with SSR hydration and compiled-template path mapping.",
  "license": "MIT",
  "exports": {
    "./lazy.js": {
      "import": {
        "types": "./dist/lazy-entry.d.ts",
        "default": "./dist/lazy-entry.js"
      }
    },
    "./template-cache.js": {
      "import": {
        "types": "./dist/template-cache-entry.d.ts",
        "default": "./dist/template-cache-entry.js"
      }
    },
    "./runtime.js": {
      "import": {
        "types": "./dist/runtime.d.ts",
        "default": "./dist/runtime.js"
      }
    },
    "./templates.js": {
      "import": {
        "types": "./dist/templates-entry.d.ts",
        "default": "./dist/templates-entry.js"
      }
    },
    "./styles.js": {
      "import": {
        "types": "./dist/styles-entry.d.ts",
        "default": "./dist/styles-entry.js"
      }
    },
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./component-asset.js": {
      "import": {
        "types": "./dist/component-asset.d.ts",
        "default": "./dist/component-asset.js"
      }
    },
    "./component-asset-runtime.js": {
      "import": {
        "types": "./dist/component-asset-runtime.d.ts",
        "default": "./dist/component-asset-runtime.js"
      }
    },
    "./streaming.js": {
      "import": {
        "types": "./dist/streaming-entry.d.ts",
        "default": "./dist/streaming-entry.js"
      }
    },
    "./lazy-hydration.js": {
      "import": {
        "types": "./dist/lazy-hydration-entry.d.ts",
        "default": "./dist/lazy-hydration-entry.js"
      }
    },
    "./interaction-hydration.js": {
      "import": {
        "types": "./dist/interaction-hydration.d.ts",
        "default": "./dist/interaction-hydration.js"
      }
    }
  },
  "files": [
    "dist/",
    "!dist/**/*.test.*"
  ],
  "scripts": {
    "build": "tsc",
    "prepack": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc --incremental false",
    "typecheck": "tsc --noEmit",
    "typecheck:e2e": "tsc -p tsconfig.test.json --noEmit",
    "test": "pnpm test:unit && pnpm test:e2e",
    "test:unit": "tsc -p tsconfig.unit-test.json --incremental false && node --test \"dist/**/*.test.js\"",
    "test:e2e": "pnpm typecheck:e2e && playwright test",
    "test:update-snapshots": "pnpm test:e2e:update-snapshots",
    "test:e2e:update-snapshots": "pnpm typecheck:e2e && playwright test --update-snapshots"
  },
  "devDependencies": {
    "@microsoft/webui-test-support": "workspace:*",
    "@playwright/test": "catalog:",
    "@types/node": "catalog:",
    "typescript": "catalog:"
  }
}

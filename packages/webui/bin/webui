#!/usr/bin/env node
// Copyright (c) Microsoft Corporation.
// Licensed under the MIT license.

import { spawnSync } from "node:child_process";
import path from "node:path";
import { fileURLToPath } from "node:url";

const root = path.dirname(fileURLToPath(import.meta.url));
const binary = process.env.WEBUI_BINARY_PATH ??
  path.join(root, process.platform === "win32" ? "webui.exe" : "webui-native");
const result = spawnSync(binary, process.argv.slice(2), { stdio: "inherit" });
if (result.error) {
  console.error(
    `[webui] Failed to start ${binary}: ${result.error.message}. ` +
      "Reinstall @microsoft/webui with optional dependencies enabled, or set WEBUI_BINARY_PATH.",
  );
  process.exitCode = 66;
} else if (result.signal) {
  process.kill(process.pid, result.signal);
} else {
  process.exitCode = result.status ?? 1;
}
